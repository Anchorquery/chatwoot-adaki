# =============================================
# Coolify Production Env Template — Chatwoot Adaki
# =============================================
# Copy values to Coolify UI → Environment Variables
# NEVER commit .env.coolify with real secrets

# --- Image ---
# After GH Actions builds & pushes: ghcr.io/<github-user>/chatwoot-adaki:latest
GHCR_IMAGE=ghcr.io/CHANGE_ME/chatwoot-adaki:latest

# --- Core ---
# Generate: openssl rand -hex 64
SECRET_KEY_BASE=REPLACE_WITH_HEX_128_CHARS

# Active Record Encryption (MFA/2FA + encrypted attributes)
# Generate locally with: docker compose run --rm rails bundle exec rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=REPLACE
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=REPLACE
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=REPLACE

FRONTEND_URL=https://chat.adaki.com
DEFAULT_LOCALE=es
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
INSTALLATION_NAME=Adaki

# --- Database ---
# POSTGRES_HOST/USERNAME/DATABASE hardcoded in compose
POSTGRES_PASSWORD=REPLACE_STRONG_PASSWORD
RAILS_MAX_THREADS=5

# --- Redis ---
REDIS_PASSWORD=REPLACE_STRONG_PASSWORD

# --- Mail (Resend example) ---
MAILER_SENDER_EMAIL=Adaki <noreply@adaki.com>
SMTP_DOMAIN=adaki.com
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=REPLACE_API_KEY
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# --- Storage (S3 recommended for production) ---
# Default = local. Switch to s3 + fill AWS_* if using S3/R2/Spaces
ACTIVE_STORAGE_SERVICE=local
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# --- Logging ---
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# --- Optional integrations (leave blank if unused) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_APP_ID=
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting ---
ENABLE_RACK_ATTACK=true
RACK_ATTACK_LIMIT=300

# --- Push notifications (generate at https://d3v.one/vapid-key-generator/) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ENABLE_PUSH_RELAY_SERVER=true

# --- Sidekiq tuning ---
SIDEKIQ_CONCURRENCY=10
